# ── Windy — server environment ───────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# These are SERVER-ONLY secrets — never expose them to the client.
# On Vercel, set the same variables in Project → Settings → Environment Variables.

# ── Azure Cosmos DB (NoSQL) ──────────────────────────────────────────────────
# Azure portal → your Cosmos account → Settings → Keys → "PRIMARY CONNECTION STRING".
# Looks like: AccountEndpoint=https://<acct>.documents.azure.com:443/;AccountKey=<key>==;
COSMOS_CONNECTION_STRING=
# Database name (created automatically by `npm run import-owners`). Default: windy
COSMOS_DATABASE=windy

# ── Google OAuth (Admin sign-in) ─────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# (type: Web application). Add the redirect URI below to "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in the Google client.
# Local dev example:   http://localhost:3000/api/auth/google/callback
# Production example:   https://your-domain.example/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Session ──────────────────────────────────────────────────────────────────
# Secret used to sign the httpOnly session cookie. Must be >= 32 chars, random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Admin bootstrap ──────────────────────────────────────────────────────────
# Comma-separated emails that become admin automatically on first sign-in.
# These bootstrap admins cannot be revoked in-app.
ADMIN_EMAILS=timbouma6@gmail.com

# ── Import script (optional) ─────────────────────────────────────────────────
# Default path to the landowner spreadsheet for `npm run import-owners`.
# You can also pass the path as an argument instead.
OWNERS_XLSX=
